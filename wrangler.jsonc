{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "space-community-service",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "withpluces.com", "custom_domain": true }],
  "build": { "command": "npm run build:worker" },
  "assets": {
    "directory": "worker-dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws/*", "/n/*", "/post/*", "/e/*", "/sitemap.xml", "/.well-known/assetlinks.json", "/", "/index.html", "/board/*", "/letter", "/letter/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "COMMUNITY", "class_name": "CommunityService" },
      { "name": "CHAT", "class_name": "ChatRoom" },
      { "name": "TALK", "class_name": "ChatService" }
    ]
  },
  "triggers": { "crons": ["0 9 * * SUN", "30 22 * * *"] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CommunityService", "ChatRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["ChatService"] }
  ],
  // 인증·비밀번호 재설정 메일 (Cloudflare Email Service)
  // Workers Paid 요금제 가입과 withpluces.com 발신 도메인 인증을 마친 뒤
  // (2026-10-06 설정 완료: Workers Paid 가입, withpluces.com 발신 도메인 인증)
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "SITE_URL": "https://withpluces.com"
    , "MAIL_FROM": "no-reply@withpluces.com"
    , "ADMIN_EMAILS": "dragon600120@gmail.com"
    , "CONTACT_EMAIL": "dragon600120@gmail.com"
    , "NEWSLETTER_SENDER": "(주)위드플러시아"
    , "NEWSLETTER_DAILY_LIMIT": "300"
    // Google Play 앱(com.withpluces.community) 서명 지문 — 공개 값. Play Console 앱 서명 키 지문을 받으면 쉼표로 이어 붙인다.
    , "ANDROID_CERT_SHA256": "F6:24:74:25:4F:7B:A4:F7:AE:A3:63:F6:81:D7:FC:2E:68:A1:E7:66:8E:31:4C:C9:41:1A:B2:B7:1F:8E:EF:11"
  }
}
